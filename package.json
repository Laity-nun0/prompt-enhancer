{
  "name": "prompt-enhancer",
  "version": "0.1.0",
  "description": "Windows desktop companion for context-aware Codex prompt enhancement",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:core": "node scripts/verify-core.ts",
    "dev": "npm run build && npm run desktop",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json",
    "test": "node --test scripts/*-unit.ts",
    "verify:model": "node scripts/verify-model-choice-real.ts",
    "verify:scope": "node scripts/verify-scope-real.ts",
    "verify:quality": "node scripts/verify-quality.ts",
    "verify:enhancement": "node scripts/verify-enhancement-real.ts",
    "verify:enhancement-suite": "node scripts/verify-enhancement-suite.ts",
    "test:enhancement": "node --test scripts/verify-enhancement-evaluation-unit.ts scripts/verify-multi-context-unit.ts",
    "test:projects": "node --test scripts/verify-projects-unit.ts",
    "test:desktop": "node --test scripts/verify-desktop-unit.ts",
    "desktop": "node scripts/start-desktop.cjs",
    "prepare:desktop": "node scripts/start-desktop.cjs --check",
    "verify:first-run": "node scripts/verify-first-run-electron.mjs",
    "test:companion": "node --test scripts/verify-companion-unit.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "package:dir": "npm run build:desktop && electron-builder --win --x64 --dir --publish never",
    "package:win": "npm run build:desktop && electron-builder --win --x64 --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@openai/codex": "0.161.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.4.4",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "main": "desktop/main.cjs",
  "author": "Prompt Enhancer contributors",
  "build": {
    "appId": "io.github.laitynun0.promptenhancer",
    "productName": "Prompt Enhancer",
    "directories": {
      "app": ".local/package-app",
      "output": "release"
    },
    "files": [
      "desktop/**",
      "server/**",
      "scripts/startup-support.cjs",
      "dist/**",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "extraResources": [
      {
        "from": "node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc",
        "to": "codex",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop/codex-LICENSE.txt",
        "to": "codex/LICENSE"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon-256.png",
      "signExecutable": false
    },
    "asar": true,
    "asarUnpack": [
      "server/**",
      "scripts/**",
      "dist/**"
    ],
    "portable": {
      "artifactName": "Prompt-Enhancer-Windows-x64.exe",
      "requestExecutionLevel": "user"
    }
  }
}
