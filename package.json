{
  "name": "prompt-enhancer",
  "version": "0.1.0",
  "description": "Windows desktop companion for context-aware Codex prompt enhancement",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:core": "node scripts/verify-core.ts",
    "dev": "node server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json",
    "test": "node --test scripts/*-unit.ts",
    "verify:model": "node scripts/verify-model-choice-real.ts",
    "verify:scope": "node scripts/verify-scope-real.ts",
    "verify:quality": "node scripts/verify-quality.ts",
    "verify:enhancement": "node scripts/verify-enhancement-real.ts",
    "verify:enhancement-suite": "node scripts/verify-enhancement-suite.ts",
    "test:enhancement": "node --test scripts/verify-enhancement-evaluation-unit.ts scripts/verify-multi-context-unit.ts",
    "test:projects": "node --test scripts/verify-projects-unit.ts",
    "test:desktop": "node --test scripts/verify-desktop-unit.ts",
    "desktop": "node scripts/start-desktop.cjs",
    "prepare:desktop": "node scripts/start-desktop.cjs --check",
    "verify:first-run": "node scripts/verify-first-run-electron.mjs",
    "test:companion": "node --test scripts/verify-companion-unit.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@openai/codex": "0.161.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.4.4",
    "typescript": "^7.0.2"
  }
}
